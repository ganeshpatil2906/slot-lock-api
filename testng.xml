<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SlotSync E2E Automation Suite" verbose="2">

    <!-- Custom Listener for ExtentReports and Playwright failure screenshots -->
    <listeners>
        <listener class-name="com.gp.slotsync.e2e.listeners.TestListener"/>
    </listeners>

    <test name="SlotSync UI and Navigation E2E Tests">
        <classes>
            <class name="com.gp.slotsync.e2e.tests.NavigationE2ETest"/>
            <class name="com.gp.slotsync.e2e.tests.AuthE2ETest"/>
            <class name="com.gp.slotsync.e2e.tests.SlotsUiE2ETest"/>
        </classes>
    </test>

</suite>
